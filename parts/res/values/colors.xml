<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
         XiaomiParts adaptive palette, LIGHT mode.

         These framework colors are Monet/RRO-backed on Android 12+ and remain
         available on Android 16/17. Because XiaomiParts is a platform app
         (platform_apis: true), it can consume the system palette directly.

         No wallpaper color is cached by XiaomiParts: when Android updates the
         system palette, these references resolve to the new accent/neutral tones.
    -->
    <color name="xp_background">@android:color/system_neutral1_10</color>
    <color name="xp_surface">@android:color/system_neutral1_50</color>
    <color name="xp_surface_alt">@android:color/system_neutral2_100</color>
    <color name="xp_surface_high">@android:color/system_neutral2_200</color>

    <!-- Material-style light primary / containers from the active Monet palette. -->
    <color name="xp_accent">@android:color/system_accent1_600</color>
    <color name="xp_accent_soft">@android:color/system_accent1_100</color>
    <color name="xp_accent_container">@android:color/system_accent1_100</color>
    <color name="xp_on_accent">@android:color/system_accent1_0</color>
    <color name="xp_on_accent_container">@android:color/system_accent1_900</color>

    <color name="xp_on_background">@android:color/system_neutral1_900</color>
    <color name="xp_on_surface">@android:color/system_neutral1_900</color>
    <color name="xp_on_surface_secondary">@android:color/system_neutral2_600</color>
    <color name="xp_outline">@android:color/system_neutral2_400</color>

    <!-- Semantic colors remain semantic rather than wallpaper-tinted. -->
    <color name="xp_danger">#B3261E</color>
    <color name="xp_on_danger">#FFFFFFFF</color>

    <!-- Hero uses the secondary Monet family for visible but calm adaptation. -->
    <color name="xp_hero">@android:color/system_accent2_100</color>
    <color name="xp_hero_text">@android:color/system_accent2_900</color>

    <color name="xp_disabled_text">@android:color/system_neutral2_500</color>
    <color name="disabled_text_color">@color/xp_disabled_text</color>
</resources>
