<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
         LIGHT mode themes. res/values-night/themes.xml supplies the matching
         dark variants. The color resources themselves resolve to the current
         Android Monet/RRO palette.
    -->
    <style name="Theme.SubSettingsBase_v31" parent="Theme.SettingsBase_v31">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:navigationBarColor">@color/xp_background</item>
        <item name="android:statusBarColor">@color/xp_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorControlNormal">@color/xp_on_surface_secondary</item>
        <item name="colorAccent">@color/xp_accent</item>
        <item name="alertDialogTheme">@style/Theme.AlertDialog.SettingsLib</item>
    </style>

    <style name="Theme.XiaomiParts.SubSettings" parent="Theme.SubSettingsBase_v31">
        <item name="android:windowBackground">@color/xp_background</item>
        <item name="android:colorAccent">@color/xp_accent</item>
        <item name="android:textColorPrimary">@color/xp_on_background</item>
        <item name="android:textColorSecondary">@color/xp_on_surface_secondary</item>
        <item name="android:navigationBarColor">@color/xp_background</item>
        <item name="android:statusBarColor">@color/xp_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.XiaomiParts.Dashboard" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/xp_background</item>
        <item name="android:colorAccent">@color/xp_accent</item>
        <item name="android:textColorPrimary">@color/xp_on_background</item>
        <item name="android:textColorSecondary">@color/xp_on_surface_secondary</item>
        <item name="android:colorControlActivated">@color/xp_accent</item>
        <item name="android:colorControlNormal">@color/xp_on_surface_secondary</item>
        <item name="android:statusBarColor">@color/xp_surface</item>
        <item name="android:navigationBarColor">@color/xp_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="XiaomiPartsUtilityCard">
        <item name="android:layout_width">176dp</item>
        <item name="android:layout_height">220dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/xp_bg_card</item>
    </style>

    <style name="XiaomiPartsUtilityIcon">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/xp_bg_accent_square</item>
        <item name="android:tint">@color/xp_on_accent</item>
    </style>

    <style name="XiaomiPartsUtilityTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textColor">@color/xp_on_background</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="XiaomiPartsUtilitySummary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/xp_on_surface_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">3</item>
    </style>

    <style name="XiaomiPartsSwitchCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/xp_bg_card</item>
        <item name="android:textColor">@color/xp_on_background</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:thumbTint">@color/xp_switch_thumb</item>
        <item name="android:trackTint">@color/xp_switch_track</item>
        <item name="android:showText">false</item>
    </style>

    <style name="XiaomiPartsCoreSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">82dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/xp_bg_card_alt</item>
        <item name="android:textColor">@color/xp_on_background</item>
        <item name="android:textSize">19sp</item>
        <item name="android:thumbTint">@color/xp_switch_thumb</item>
        <item name="android:trackTint">@color/xp_switch_track</item>
    </style>

    <style name="XiaomiPartsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/xp_outline</item>
    </style>
</resources>
