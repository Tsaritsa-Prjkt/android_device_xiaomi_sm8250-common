<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/screen_enhance_engine_title">

    <com.android.settingslib.widget.FooterPreference
        android:key="vpp_omx_hint"
        android:selectable="false"
        android:title="@string/screen_enhance_engine_omx_hint" />

    <PreferenceCategory
        android:title="@string/screen_enhance_engine_features_category">

        <SwitchPreferenceCompat
            android:key="screen_enhance_engine_s2h_enable"
            android:title="@string/screen_enhance_engine_s2h_title"
            android:summary="@string/screen_enhance_engine_s2h_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="screen_enhance_engine_memc_enable"
            android:title="@string/screen_enhance_engine_memc_title"
            android:summary="@string/screen_enhance_engine_memc_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/vpp_apps_category_title">

        <org.lineageos.settings.vpp.preferences.IconAppListPreference
            android:key="vpp_video_apps"
            android:title="@string/vpp_select_apps_title"
            android:summary="@string/vpp_select_apps_summary_none"
            android:dialogTitle="@string/vpp_select_apps_dialog_title"
            android:positiveButtonText="@android:string/ok"
            android:negativeButtonText="@android:string/cancel" />

    </PreferenceCategory>

</PreferenceScreen>
