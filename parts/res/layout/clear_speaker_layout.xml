<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/clear_speaker_summary"
            android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />

        <FrameLayout
            android:layout_width="272dp"
            android:layout_height="272dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/parts_ring_background">

            <ImageButton
                android:id="@+id/clear_speaker_action"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:background="@drawable/parts_circle_button_background"
                android:contentDescription="@string/clear_speaker_start"
                android:padding="30dp"
                android:src="@drawable/ic_play" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/parts_card_background"
            android:paddingHorizontal="24dp"
            android:paddingVertical="22dp"
            android:text="@string/clear_speaker_description"
            android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
