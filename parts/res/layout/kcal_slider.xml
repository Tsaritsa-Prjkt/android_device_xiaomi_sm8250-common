<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="vertical">
    <View
        android:id="@+id/kcal_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        android:alpha="0.18"
        android:background="@color/settingslib_materialColorOnSurfaceVariant"
        android:importantForAccessibility="no"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/kcal_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/kcal_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>
    <SeekBar
        android:id="@+id/kcal_slider"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="14dp"
        android:maxHeight="14dp"
        android:paddingHorizontal="4dp"
        android:progressDrawable="@drawable/kcal_track"
        android:thumb="@drawable/kcal_thumb"
        android:thumbOffset="2dp"
        android:saveEnabled="false"
        android:enabled="false"
        android:splitTrack="true" />
</LinearLayout>
