<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/xp_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:background="@drawable/xp_bg_header">

        <ImageButton
            android:id="@+id/xp_back"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/xp_bg_round_button"
            android:contentDescription="@android:string/cancel"
            android:padding="17dp"
            android:src="@drawable/ic_xp_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:text="@string/xiaomiparts_header_title"
            android:textColor="@color/xp_on_background"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="22dp"
            android:paddingEnd="28dp"
            android:paddingBottom="42dp">

            <!-- Device identity card. Device label is resolved at runtime from ro.product.*. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="@drawable/xp_bg_hero">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xiaomiparts_shell_prompt"
                        android:textColor="@color/xp_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/xp_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="2"
                        android:textColor="@color/xp_on_background"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/xp_device_codename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/xp_on_surface_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/xiaomiparts_device_subtitle"
                        android:textColor="@color/xp_on_surface_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/device_settings_app_name"
                    android:src="@drawable/ic_xiaomiparts_logo" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="@string/xiaomiparts_performance_section"
                android:textColor="@color/xp_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <!-- Performance grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:id="@+id/card_gpu"
                        android:layout_width="match_parent"
                        android:layout_height="196dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/xp_bg_card">
                        <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="12dp" android:background="@drawable/xp_bg_accent_square" android:src="@drawable/ic_gpu_manager" android:tint="@color/xp_on_accent" android:contentDescription="@string/gpu_manager_title" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/gpu_manager_title" android:textColor="@color/xp_on_background" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:text="@string/xiaomiparts_gpu_summary" android:textColor="@color/xp_on_surface_secondary" android:textSize="13sp" />
                        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end" android:padding="10dp" android:background="@drawable/xp_bg_round_button" android:src="@drawable/ic_xp_arrow_forward" android:contentDescription="@string/gpu_manager_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_thermal"
                        android:layout_width="match_parent"
                        android:layout_height="222dp"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/xp_bg_card">
                        <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="12dp" android:background="@drawable/xp_bg_accent_square" android:src="@drawable/ic_thermal" android:tint="@color/xp_on_accent" android:contentDescription="@string/thermal_title" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Thermal Engine" android:textColor="@color/xp_on_background" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:text="@string/xiaomiparts_thermal_summary" android:textColor="@color/xp_on_surface_secondary" android:textSize="13sp" />
                        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end" android:padding="10dp" android:background="@drawable/xp_bg_round_button" android:src="@drawable/ic_xp_arrow_forward" android:contentDescription="@string/thermal_title" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <LinearLayout
                        android:id="@+id/card_core"
                        android:layout_width="match_parent"
                        android:layout_height="222dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/xp_bg_card_alt">
                        <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="12dp" android:background="@drawable/xp_bg_round_button_dark" android:src="@drawable/ic_xp_core" android:tint="@color/xp_accent" android:contentDescription="@string/core_control_title" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/core_control_title" android:textColor="@color/xp_on_background" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:text="@string/xiaomiparts_core_summary" android:textColor="@color/xp_on_surface_secondary" android:textSize="13sp" />
                        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end" android:padding="10dp" android:background="@drawable/xp_bg_round_button_dark" android:src="@drawable/ic_xp_arrow_forward" android:tint="@color/xp_accent" android:contentDescription="@string/core_control_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_kernel"
                        android:layout_width="match_parent"
                        android:layout_height="196dp"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/xp_bg_card_alt">
                        <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="12dp" android:background="@drawable/xp_bg_round_button_dark" android:src="@drawable/ic_kernel_manager" android:tint="@color/xp_accent" android:contentDescription="@string/kernel_manager_title" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/kernel_manager_title" android:textColor="@color/xp_on_background" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:text="@string/xiaomiparts_kernel_summary" android:textColor="@color/xp_on_surface_secondary" android:textSize="13sp" />
                        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end" android:padding="10dp" android:background="@drawable/xp_bg_round_button_dark" android:src="@drawable/ic_xp_arrow_forward" android:tint="@color/xp_accent" android:contentDescription="@string/kernel_manager_title" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:layout_marginBottom="16dp"
                android:text="@string/xiaomiparts_utilities_section"
                android:textColor="@color/xp_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/card_clear_speaker" style="@style/XiaomiPartsUtilityCard">
                        <ImageView style="@style/XiaomiPartsUtilityIcon" android:src="@drawable/ic_clear_speaker" android:contentDescription="@string/clear_speaker_title" />
                        <TextView style="@style/XiaomiPartsUtilityTitle" android:text="@string/clear_speaker_title" />
                        <TextView style="@style/XiaomiPartsUtilitySummary" android:text="@string/clear_speaker_summary" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/card_refresh" style="@style/XiaomiPartsUtilityCard">
                        <ImageView style="@style/XiaomiPartsUtilityIcon" android:src="@drawable/ic_qs_refresh_rate" android:contentDescription="@string/refresh_title" />
                        <TextView style="@style/XiaomiPartsUtilityTitle" android:text="@string/xiaomiparts_smooth_display" />
                        <TextView style="@style/XiaomiPartsUtilitySummary" android:text="@string/xiaomiparts_refresh_summary" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/card_charge" style="@style/XiaomiPartsUtilityCard">
                        <ImageView style="@style/XiaomiPartsUtilityIcon" android:src="@drawable/charger_24px" android:contentDescription="@string/charge_bypass_title" />
                        <TextView style="@style/XiaomiPartsUtilityTitle" android:text="@string/charge_bypass_title" />
                        <TextView style="@style/XiaomiPartsUtilitySummary" android:text="@string/xiaomiparts_charge_summary" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/card_saturation" style="@style/XiaomiPartsUtilityCard">
                        <ImageView style="@style/XiaomiPartsUtilityIcon" android:src="@drawable/ic_saturation_tile" android:contentDescription="@string/saturation_title" />
                        <TextView style="@style/XiaomiPartsUtilityTitle" android:text="@string/saturation_title" />
                        <TextView style="@style/XiaomiPartsUtilitySummary" android:text="@string/xiaomiparts_saturation_summary" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/card_dc" style="@style/XiaomiPartsUtilityCard">
                        <ImageView style="@style/XiaomiPartsUtilityIcon" android:src="@drawable/ic_dcdimming" android:contentDescription="@string/dc_dimming_enable_title" />
                        <TextView style="@style/XiaomiPartsUtilityTitle" android:text="@string/dc_dimming_enable_title" />
                        <TextView style="@style/XiaomiPartsUtilitySummary" android:text="@string/xiaomiparts_dc_summary" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/card_hbm" style="@style/XiaomiPartsUtilityCard">
                        <ImageView style="@style/XiaomiPartsUtilityIcon" android:src="@drawable/ic_hbm_tile" android:contentDescription="@string/hbm_fragment_title" />
                        <TextView style="@style/XiaomiPartsUtilityTitle" android:text="@string/hbm_fragment_title" />
                        <TextView style="@style/XiaomiPartsUtilitySummary" android:text="@string/xiaomiparts_hbm_summary" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/card_touch" style="@style/XiaomiPartsUtilityCard">
                        <ImageView style="@style/XiaomiPartsUtilityIcon" android:src="@drawable/ic_htsr" android:contentDescription="@string/htsr_title" />
                        <TextView style="@style/XiaomiPartsUtilityTitle" android:text="@string/htsr_title" />
                        <TextView style="@style/XiaomiPartsUtilitySummary" android:text="@string/xiaomiparts_touch_summary" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/card_dirac" style="@style/XiaomiPartsUtilityCard">
                        <ImageView style="@style/XiaomiPartsUtilityIcon" android:src="@drawable/ic_headphone" android:contentDescription="@string/dirac_title" />
                        <TextView style="@style/XiaomiPartsUtilityTitle" android:text="@string/xiaomiparts_misound" />
                        <TextView style="@style/XiaomiPartsUtilitySummary" android:text="@string/xiaomiparts_dirac_summary" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
