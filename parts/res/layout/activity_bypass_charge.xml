<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/xp_background" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center_vertical"
        android:paddingStart="24dp" android:paddingEnd="24dp">
        <ImageButton android:id="@+id/xp_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@android:color/transparent" android:padding="12dp" android:src="@drawable/ic_xp_arrow_back"
            android:tint="@color/xp_on_surface_secondary" android:contentDescription="@android:string/cancel" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="28dp" android:paddingTop="34dp" android:paddingEnd="28dp" android:paddingBottom="40dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/charge_bypass_title"
                android:textColor="@color/xp_on_background" android:textSize="35sp" android:fontFamily="sans-serif-light" />

            <FrameLayout android:layout_width="match_parent" android:layout_height="430dp" android:layout_marginTop="24dp">
                <View android:layout_width="250dp" android:layout_height="250dp" android:layout_gravity="center"
                    android:background="@drawable/xp_bg_outline_circle" android:alpha="0.45" />
                <ImageView android:layout_width="90dp" android:layout_height="90dp" android:layout_gravity="center"
                    android:padding="22dp" android:src="@drawable/charger_24px" android:tint="@color/xp_accent"
                    android:contentDescription="@string/charge_bypass_title" />
            </FrameLayout>

            <Switch android:id="@+id/bypass_switch" style="@style/XiaomiPartsSwitchCard"
                android:text="Bypass charging\nEnable direct charging, bypassing battery" />

            <TextView android:id="@+id/bypass_warning" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:text="@string/charge_bypass_warning" android:textColor="@color/xp_accent" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
