<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <LinearLayout
        android:id="@+id/thermal_enabled_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/parts_card_background"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/thermal_enable_title"
                android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                android:textColor="@color/settingslib_materialColorOnSurface" />

            <TextView
                android:id="@+id/thermal_enabled_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/thermal_enable_summary"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
        </LinearLayout>

        <Switch
            android:id="@+id/thermal_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/thermal_enable_title" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:text="@string/apps_title"
        android:textAppearance="@style/TextAppearance.SettingsLib.TitleSmall"
        android:textColor="@color/settingslib_materialColorPrimary" />

    <LinearLayout
        android:id="@+id/thermal_search_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/parts_search_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/thermal_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_apps_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge"
            android:textColor="@color/settingslib_materialColorOnSurface"
            android:textColorHint="@color/settingslib_materialColorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/thermal_search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_search"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/thermal_rv_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:background="?android:attr/colorBackground"
        android:paddingBottom="8dp"
        android:scrollbarStyle="insideOverlay" />
</LinearLayout>
