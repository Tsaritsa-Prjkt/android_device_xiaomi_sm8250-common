<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/xp_background" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center_vertical"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:background="@drawable/xp_bg_header">
        <ImageButton android:id="@+id/xp_back" android:layout_width="50dp" android:layout_height="50dp"
            android:background="@drawable/xp_bg_round_button_dark" android:padding="12dp" android:src="@drawable/ic_xp_arrow_back"
            android:tint="@color/xp_on_surface_secondary" android:contentDescription="@android:string/cancel" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="24dp" android:paddingTop="54dp" android:paddingEnd="24dp" android:paddingBottom="42dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/core_control_title"
                android:textColor="@color/xp_on_background" android:textSize="42sp" android:fontFamily="sans-serif-light" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp"
                android:orientation="vertical" android:background="@drawable/xp_bg_card_alt">
                <Switch android:id="@+id/core_0_switch" style="@style/XiaomiPartsCoreSwitch" android:text="@string/core_0" />
                <View style="@style/XiaomiPartsDivider" />
                <Switch android:id="@+id/core_1_switch" style="@style/XiaomiPartsCoreSwitch" android:text="@string/core_1" />
                <View style="@style/XiaomiPartsDivider" />
                <Switch android:id="@+id/core_2_switch" style="@style/XiaomiPartsCoreSwitch" android:text="@string/core_2" />
                <View style="@style/XiaomiPartsDivider" />
                <Switch android:id="@+id/core_3_switch" style="@style/XiaomiPartsCoreSwitch" android:text="@string/core_3" />
                <View style="@style/XiaomiPartsDivider" />
                <Switch android:id="@+id/core_4_switch" style="@style/XiaomiPartsCoreSwitch" android:text="@string/core_4" />
                <View style="@style/XiaomiPartsDivider" />
                <Switch android:id="@+id/core_5_switch" style="@style/XiaomiPartsCoreSwitch" android:text="@string/core_5" />
                <View style="@style/XiaomiPartsDivider" />
                <Switch android:id="@+id/core_6_switch" style="@style/XiaomiPartsCoreSwitch" android:text="@string/core_6" />
                <View style="@style/XiaomiPartsDivider" />
                <Switch android:id="@+id/core_7_switch" style="@style/XiaomiPartsCoreSwitch" android:text="@string/core_7" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:orientation="horizontal" android:padding="10dp">
                <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="ⓘ"
                    android:textColor="@color/xp_on_surface_secondary" android:textSize="28sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="12dp" android:text="Advanced CPU control. Turning off cores may reduce power or thermal load, but can reduce performance and stability. At least two little cores remain online."
                    android:textColor="@color/xp_on_surface_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
