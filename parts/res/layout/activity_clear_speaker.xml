<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/xp_background" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center_vertical"
        android:paddingStart="24dp" android:paddingEnd="24dp">
        <ImageButton android:id="@+id/xp_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@android:color/transparent" android:padding="12dp" android:src="@drawable/ic_xp_arrow_back"
            android:tint="@color/xp_on_surface_secondary" android:contentDescription="@android:string/cancel" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/clear_speaker_title" android:textColor="@color/xp_on_background" android:textSize="25sp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="38dp" android:paddingTop="24dp" android:paddingEnd="38dp" android:paddingBottom="36dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:text="@string/clear_speaker_summary" android:textColor="@color/xp_on_surface_secondary" android:textSize="18sp" />

            <FrameLayout android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp" android:background="@drawable/xp_bg_outline_circle">
                <ToggleButton android:id="@+id/clear_speaker_toggle" android:layout_width="120dp" android:layout_height="120dp"
                    android:layout_gravity="center" android:background="@drawable/xp_bg_play_circle"
                    android:textOff="▶" android:textOn="Ⅱ" android:textSize="44sp" android:textColor="@color/xp_accent_soft"
                    android:textAllCaps="false" />
            </FrameLayout>

            <TextView android:id="@+id/clear_speaker_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:gravity="center" android:text="Ready" android:textColor="@color/xp_accent" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="48dp"
                android:padding="22dp" android:background="@drawable/xp_bg_card" android:text="@string/clear_speaker_description"
                android:textColor="@color/xp_on_surface_secondary" android:textSize="15sp" android:lineSpacingExtra="5dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
