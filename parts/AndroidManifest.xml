<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings"
    android:versionCode="3"
    android:versionName="3.0"
    android:sharedUserId="android.uid.system">

    <!-- Runtime capabilities actually used by XiaomiParts on Android 16/17. -->
    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Android 11+ package visibility for per-app thermal/refresh selectors. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PartsApplication"
        android:icon="@drawable/ic_xiaomiparts_logo"
        android:label="@string/device_settings_app_name"
        android:persistent="true"
        android:theme="@style/Theme.XiaomiParts.SubSettings"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:supportsRtl="true">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Single Settings entry point. Child features remain internal to XiaomiParts. -->
        <activity
            android:name=".XiaomiPartsActivity"
            android:exported="true"
            android:label="@string/device_settings_app_name"
            android:theme="@style/Theme.XiaomiParts.Dashboard">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/xiaomiparts_settings_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_xiaomiparts_logo" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="false" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-255" />
        </activity>

        <!-- Internal feature pages -->
        <activity
            android:name=".gpumanager.GpuManagerActivity"
            android:exported="false"
            android:label="@string/gpu_manager_title"
            android:theme="@style/Theme.XiaomiParts.Dashboard" />

        <activity
            android:name=".corecontrol.CoreControlActivity"
            android:exported="false"
            android:label="@string/core_control_title"
            android:theme="@style/Theme.XiaomiParts.Dashboard" />

        <activity
            android:name=".thermal.ThermalActivity"
            android:exported="false"
            android:label="@string/thermal_title"
            android:theme="@style/Theme.XiaomiParts.SubSettings" />

        <activity
            android:name=".kernelmanager.KernelManagerActivity"
            android:exported="false"
            android:label="@string/kernel_manager_title"
            android:theme="@style/Theme.XiaomiParts.Dashboard" />

        <activity
            android:name=".refreshrate.RefreshActivity"
            android:exported="false"
            android:label="@string/refresh_title"
            android:theme="@style/Theme.XiaomiParts.SubSettings" />

        <activity
            android:name=".speaker.ClearSpeakerActivity"
            android:exported="false"
            android:label="@string/clear_speaker_title"
            android:theme="@style/Theme.XiaomiParts.Dashboard" />

        <activity
            android:name=".charge.ChargeActivity"
            android:exported="false"
            android:label="@string/charge_bypass_title"
            android:theme="@style/Theme.XiaomiParts.Dashboard" />

        <activity
            android:name=".saturation.SaturationActivity"
            android:exported="false"
            android:label="@string/saturation_title"
            android:theme="@style/Theme.XiaomiParts.SubSettings" />

        <activity
            android:name=".display.DcDimmingSettingsActivity"
            android:exported="false"
            android:label="@string/dc_dimming_enable_title"
            android:theme="@style/Theme.XiaomiParts.SubSettings" />

        <activity
            android:name=".hbm.HBMActivity"
            android:exported="false"
            android:label="@string/hbm_fragment_title"
            android:theme="@style/Theme.XiaomiParts.SubSettings" />

        <activity
            android:name=".touchsampling.TouchSamplingSettingsActivity"
            android:exported="false"
            android:label="@string/htsr_enable_title"
            android:theme="@style/Theme.XiaomiParts.SubSettings" />

        <activity
            android:name=".dirac.DiracActivity"
            android:exported="false"
            android:label="@string/dirac_title"
            android:theme="@style/Theme.XiaomiParts.SubSettings" />

        <!-- Private in-process profile services. -->
        <service
            android:name=".thermal.ThermalService"
            android:exported="false" />

        <service
            android:name=".refreshrate.RefreshService"
            android:exported="false" />

        <service
            android:name=".hbm.AutoHBMService"
            android:exported="false" />

        <!-- Quick Settings tiles -->
        <service
            android:name=".display.DcDimmingTileService"
            android:exported="true"
            android:icon="@drawable/ic_dc_tile"
            android:label="@string/dc_dimming_enable_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".thermal.ThermalTileService"
            android:exported="true"
            android:icon="@drawable/ic_thermal_settings"
            android:label="@string/thermal_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".touchsampling.TouchSamplingTileService"
            android:exported="true"
            android:icon="@drawable/ic_htsr"
            android:label="@string/htsr_enable_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".dirac.DiracTileService"
            android:exported="true"
            android:icon="@drawable/ic_headphone"
            android:label="@string/dirac_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".RefreshRateTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_refresh_rate"
            android:label="@string/refresh_rate_tile_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".hbm.HBMModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_hbm_tile"
            android:label="@string/hbm_mode_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".charge.BypassChargeTileService"
            android:exported="true"
            android:icon="@drawable/charger_24px"
            android:label="@string/charge_bypass_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".saturation.SaturationTileService"
            android:exported="true"
            android:icon="@drawable/ic_saturation_tile"
            android:label="@string/saturation_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
