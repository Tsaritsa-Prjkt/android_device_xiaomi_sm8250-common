# Only the configured fast-charge preference, not the whole qcom-battery class.
allow hal_lineage_health_default vendor_sysfs_charging_speed:file rw_file_perms;

r_dir_file(hal_lineage_health_default, sysfs_batteryinfo)
allow hal_lineage_health_default sysfs_batteryinfo:file rw_file_perms;
allow hal_lineage_health_default vendor_sysfs_battery_supply:dir search;
